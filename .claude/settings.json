{
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(vercel ls *)",
      "Bash(vercel inspect *)",
      "Bash(vercel logs *)",
      "Bash(vercel env ls *)",
      "Bash(vercel env pull *)",
      "Bash(pnpm qa)",
      "Bash(pnpm check-types)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)"
    ],
    "ask": [
      "Bash(gh repo delete *)",
      "Bash(vercel env rm *)",
      "Bash(vercel remove *)",
      "Bash(pnpm db:migrate)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && pnpm install --frozen-lockfile || true"
          }
        ]
      }
    ]
  }
}
