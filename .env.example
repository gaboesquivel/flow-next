# Assistant /api/chat — direct Anthropic (optional local dev)
ANTHROPIC_API_KEY=

# GenUI compose via Vercel AI Gateway when set
AI_GATEWAY_API_KEY=

# Optional Eve agent model (default anthropic/claude-sonnet-4-20250514)
# EVE_AGENT_MODEL=

# Optional Jev routing for ambiguous compose prompts
# TYPESAFE_API_KEY=
# GENUI_MODEL=anthropic/claude-sonnet-4.6

# Operator (protected surfaces) — min 16 characters; unset disables Operator fail-closed
OPERATOR_SECRET=
# Deprecated alias (flow-next only): OPERATOR_ACCESS_TOKEN=
